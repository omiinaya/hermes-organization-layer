+
+def test_parse_duration_accepts_hr_hrs_hour_hours(hermes_home):
+    """#timed-goal: '1hr' (and hour variants) must parse as seconds-to-minutes.
+
+    Regression: only bare 'h'/'m' were accepted, so '/goal upgrade x 1hr'
+    produced a NON-timed goal (deadline None) — the agent worked ~1 turn and
+    stopped instead of grinding the full hour. '1hr' is the most common
+    spelling in the user's real goal messages, so it must resolve to 60m.
+    """
+    from hermes_cli.goal_command import _parse_duration
+
+    # hour spellings -> 60 minutes (timed), not None (untimed)
+    for suf in ("1h", "1hr", "1hrs", "1hour", "1hours"):
+        text, mins = _parse_duration(f"upgrade sentinel {suf}")
+        assert text == "upgrade sentinel", suf
+        assert mins == 60, f"{suf}: expected 60, got {mins}"
+    for suf in ("for 1h", "for 1hr", "for 2hours"):
+        text, mins = _parse_duration(f"upgrade sentinel {suf}")
+        assert mins in (60, 120), f"{suf}: expected timed, got {mins}"
+
+    # minutes still work, explicit 'for', and bare no-unit = bare minutes
+    assert _parse_duration("upgrade sentinel 90m")[1] == 90
+    assert _parse_duration("upgrade sentinel 45")[1] == 45
+    assert _parse_duration("upgrade sentinel for 45")[1] == 45
+
+    # no duration -> NOT timed (None), goal text preserved
+    assert _parse_duration("upgrade sentinel") == ("upgrade sentinel", None)
