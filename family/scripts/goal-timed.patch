diff --git a/tests/agent/test_timed_goal_clarify_gate.py b/tests/agent/test_timed_goal_clarify_gate.py
new file mode 100644
index 0000000000..675856aaca
--- /dev/null
+++ b/tests/agent/test_timed_goal_clarify_gate.py
@@ -0,0 +1,63 @@
+"""Structural guard: clarify() must be refused while a timed goal is mid-run.
+
+A timed goal (/goal … for <N>h|m) forces continued autonomous work until the
+deadline. The agent must not burn the clock waiting on a user answer — it should
+proceed with its recommended option or defer the question. This is enforced at the
+dispatch layer so it holds regardless of session.
+"""
+
+import time
+from types import SimpleNamespace
+
+from agent.tool_executor import _resolve_sequential_dispatch
+
+
+def _set_fake_goal(session_id, deadline):
+    """Store a goal row in the real SessionDB keyed by session_id so load_goal sees it."""
+    from hermes_cli.goals import GoalState, save_goal
+    st = GoalState(goal="timed test", status="active", turns_used=0, created_at=time.time(),
+                   last_turn_at=0.0, max_turns=20, deadline=deadline)
+    save_goal(session_id, st)
+
+
+def _ref():
+    return SimpleNamespace(name="clarify", args={"question": "pick one?"},
+                           task_id="task-1", call_id="call-1", trace=[])
+
+
+def _agent(session_id):
+    return SimpleNamespace(session_id=session_id,
+                           clarify_callback=lambda *a, **k: '{"user_response": "x"}')
+
+
+def _run(session_id):
+    dispatch = _resolve_sequential_dispatch(_agent(session_id), _ref(), [])
+    return dispatch.execute({})
+
+
+def test_clarify_refused_during_active_timed_goal(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    sid = "clf-timed-active"
+    _set_fake_goal(sid, time.time() + 60)          # deadline in the future
+    out = _run(sid)
+    assert isinstance(out, dict) and "error" in out, out
+    assert "Timed goal in progress" in out["error"]
+
+
+def test_clarify_not_refused_when_deadline_passed(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    sid = "clf-timed-past"
+    _set_fake_goal(sid, time.time() - 60)          # deadline passed → normal judging
+    out = _run(sid)
+    # Not structurally refused → not the timed-goal error.
+    assert not (isinstance(out, dict) and "Timed goal in progress" in out.get("error", ""))
+
+
+def test_clarify_not_refused_with_no_timed_goal(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    sid = "clf-plain"
+    from hermes_cli.goals import GoalState, save_goal
+    save_goal(sid, GoalState(goal="plain", status="active", turns_used=0, created_at=time.time(),
+                             last_turn_at=0.0, max_turns=20, deadline=0.0))
+    out = _run(sid)
+    assert not (isinstance(out, dict) and "Timed goal in progress" in out.get("error", ""))
