+def _parse_duration(arg: str) -> tuple[str, int | None]:
+    """Split a trailing duration off a goal string.
+
+    Accepts: 'upgrade sentinel for 1h', 'for 90m', 'for 45', and bare suffixes
+    'upgrade sentinel 1h', 'upgrade sentinel 90m', 'upgrade sentinel 45'.
+    Returns (goal_text, minutes_or_None).
+    """
+    import re
+    # Prefer explicit 'for <N>h|m'; also accept bare '<N>h|m' or just '<N>' minutes.
+    # Unit also accepts 'hr'/'hrs'/'hour'/'hours' (case-insensitive) — the common
+    # "1hr" spelling must resolve to an hour, not a plain (non-timed) goal.
+    m = re.search(r"(?:\s+for\s+|\Afor\s+)(\d+)(h|m|hr|hrs|hour|hours)?\s*$", arg, flags=re.IGNORECASE)
+    if m:
+        num, unit = int(m.group(1)), (m.group(2) or "m").lower()
+        minutes = num * 60 if unit.startswith("h") else num
+        goal_text = arg[: m.start()].strip()
+        return (goal_text or "focused work"), max(1, min(480, minutes))
+    m2 = re.search(r"\s+(\d+)(h|m|hr|hrs|hour|hours)?\s*$", arg, flags=re.IGNORECASE)
+    if m2:
+        num, unit = int(m2.group(1)), (m2.group(2) or "m").lower()
+        minutes = num * 60 if unit.startswith("h") else num
+        goal_text = arg[: m2.start()].strip()
+        return (goal_text or "focused work"), max(1, min(480, minutes))
+    return arg.strip(), None
+
